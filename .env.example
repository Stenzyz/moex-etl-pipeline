# FERNET_KEY, AIRFLOW_JWT_SECRET, SUPERSET_SECRET_KEY: make gen-keys
# в паролях без $, # и кавычек, иначе compose их ломает

AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change_me
FERNET_KEY=
AIRFLOW_JWT_SECRET=

AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
SUPERSET_DB=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=change_me

# не менять, DDL завязан на moex
CLICKHOUSE_DB=moex
CLICKHOUSE_USER=moex_admin
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_HTTP_PORT=8123

# они же логин и пароль root в MinIO, пароль от 8 символов
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=change_me_please
S3_BUCKET=moex-lake
S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# пауза между запросами к ISS; на 20 запросах подряд без паузы лимит не сработал
ISS_REQUEST_DELAY=0.1

SPARK_UI_PORT=8081
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g

SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me

TELEGRAM_BOT_TOKEN=
